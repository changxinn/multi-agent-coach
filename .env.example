# ===========================================
# JWT Configuration
# ===========================================
# IMPORTANT: Change this in production! Use at least 32 characters.
JWT_SECRET_KEY=your-super-secret-key-min-32-chars-long
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ===========================================
# Database Configuration
# ===========================================
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/systemdb
DATABASE_SCHEMA=systemdb
# Required only for PostgreSQL-backed Nutrition integration tests. It must
# target the disposable database named exactly nutrition_test and differ from
# DATABASE_URL; the test suite fails closed for every other target.
NUTRITION_TEST_DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/nutrition_test

# Seed admin user (created on first backend start)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=System Admin

# ===========================================
# Session Configuration
# ===========================================
SESSION_EXPIRY_HOURS=24

# ===========================================
# CORS Configuration
# ===========================================
FRONTEND_URL=http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:3000

# ===========================================
# LLM Configuration
# ===========================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-5-nano

# ===========================================
# Internal Agent Services
# ===========================================
# Recovery Agent (disabled by default)
USE_RECOVERY_AGENT_SERVICE=false
RECOVERY_AGENT_URL=http://localhost:8001

# Nutrition Agent (disabled by default)
USE_NUTRITION_AGENT_SERVICE=false
NUTRITION_AGENT_URL=http://localhost:8003
NUTRITION_AGENT_ROLLOUT_PERCENT=0
NUTRITION_INTERNAL_SERVICE_TOKEN=local-dev-nutrition-token
NUTRITION_LLM_ENABLED=false
USDA_FDC_API_KEY=
# USDA cache/refresh policy (per Nutrition Agent instance)
FOOD_CACHE_FRESH_DAYS=30
FOOD_CACHE_MAX_STALE_DAYS=180
USDA_REFRESH_SUPPRESSION_MINUTES=15
USDA_CONNECT_TIMEOUT_SECONDS=2
USDA_READ_TIMEOUT_SECONDS=5
USDA_REQUEST_TIMEOUT_SECONDS=10
USDA_MAX_RESULTS=50
USDA_REQUESTS_PER_MINUTE=30
USDA_REQUESTS_PER_HOUR=1000
USDA_REQUESTS_PER_DAY=10000

# Internal service token for Recovery Agent microservice communication
INTERNAL_SERVICE_TOKEN=local-dev-recovery-token

# ===========================================
# AWS Configuration (Production Only)
# Leave blank for local development
# ===========================================
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PREFIX=chat-history

# ===========================================
# Redis Configuration (Production Only)
# Leave blank for local development
# ===========================================
REDIS_URL=

# ===========================================
# Application Settings
# ===========================================
APP_NAME=Multi-Agent Coach API
APP_VERSION=1.0.0
APP_ENV=development
DEBUG=false
