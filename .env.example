# ===========================================
# JWT Configuration
# ===========================================
# IMPORTANT: Change this in production! Use at least 32 characters.
JWT_SECRET_KEY=your-super-secret-key-min-32-chars-long
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ===========================================
# Database Configuration
# ===========================================
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/systemdb
DATABASE_SCHEMA=systemdb

# Nutrition Agent-private PostgreSQL database for direct local Uvicorn execution.
# Keep it separate from the main application's systemdb database. Docker Compose
# overrides this with its internal nutrition-db hostname.
NUTRITION_DATABASE_URL=postgresql://nutrition_agent:YOUR_PASSWORD@127.0.0.1:5433/nutritiondb
TRAINING_DATABASE_URL=postgresql://training_agent:YOUR_PASSWORD@127.0.0.1:5434/trainingdb
TRAINING_DB_USER=training_agent
# Required by docker compose; set a unique strong local-development password.
TRAINING_DB_PASSWORD=CHANGE_ME_TO_A_STRONG_LOCAL_PASSWORD
RUN_MIGRATIONS=true

# Local demo users are disabled by default. Docker Compose enables them.
SEED_DEMO_USERS=false

# ===========================================
# Session Configuration
# ===========================================
SESSION_EXPIRY_HOURS=24

# ===========================================
# CORS Configuration
# ===========================================
FRONTEND_URL=http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:3000

# ===========================================
# LLM Configuration
# ===========================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
OPENAI_BASE_URL=https://api.openai.com/v1
LLM_MODEL=gpt-5-nano

# Nutrition Agent LLM behaviour
NUTRITION_LLM_ENABLED=true
NUTRITION_MEAL_PLAN_LLM_ENABLED=true
NUTRITION_LLM_REASONING_EFFORT=low
NUTRITION_LLM_DEBUG_LOG_REQUESTS=false
NUTRITION_LLM_DEBUG_LOG_RESPONSES=false
NUTRITION_MEAL_PLAN_GENERATION_TIMEOUT_SECONDS=120

# ===========================================
# Internal Agent Services
# Leave USE_* flags false for local uvicorn (in-process fallback).
# docker compose sets these to true automatically.
# ===========================================
INTERNAL_SERVICE_TOKEN=local-dev-recovery-token
USE_RECOVERY_AGENT_SERVICE=false
RECOVERY_AGENT_URL=http://localhost:8001
USE_HEAD_COACH_SERVICE=false
HEAD_COACH_URL=http://localhost:8002
USE_SUMMARIZER_SERVICE=false
SUMMARIZER_URL=http://localhost:8003
USE_NUTRITION_AGENT_SERVICE=false
NUTRITION_AGENT_URL=http://localhost:8004
USE_TRAINING_AGENT_SERVICE=false
TRAINING_AGENT_URL=http://localhost:8005
TRAINING_AGENT_TIMEOUT_SECONDS=20

# USDA FoodData Central API key for nutrition food searches and details.
USDA_FDC_API_KEY=

# ===========================================
# AWS Configuration (Production Only)
# Leave blank for local development
# ===========================================
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PREFIX=chat-history

# ===========================================
# Redis Configuration (Production Only)
# Leave blank for local development
# ===========================================
REDIS_URL=

# ===========================================
# Application Settings
# ===========================================
APP_NAME=Multi-Agent Coach API
APP_VERSION=1.0.0
DEBUG=false

# Private Recovery Agent database (Compose uses the recovery-db hostname).
RECOVERY_DATABASE_URL=postgresql://recovery_agent:YOUR_PASSWORD@localhost:5432/recoverydb
RECOVERY_DATABASE_SCHEMA=recovery
RECOVERY_DB_USER=recovery_agent
# Required by docker compose; set a unique strong local-development password.
RECOVERY_DB_PASSWORD=CHANGE_ME_TO_A_STRONG_LOCAL_PASSWORD
