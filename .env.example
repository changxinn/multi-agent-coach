# ===========================================
# JWT Configuration
# ===========================================
# IMPORTANT: Change this in production! Use at least 32 characters.
JWT_SECRET_KEY=your-super-secret-key-min-32-chars-long
JWT_ALGORITHM=HS256
JWT_EXPIRY_HOURS=24

# ===========================================
# Database Configuration
# ===========================================
# Format: postgresql+asyncpg://user:password@host:port/database
DATABASE_URL=postgresql+asyncpg://postgres:YOUR_PASSWORD@localhost:5432/systemdb
DATABASE_SCHEMA=systemdb

# Seed admin user (created on first backend start)
SEED_ADMIN_EMAIL=admin@example.com
SEED_ADMIN_PASSWORD=ChangeMe123!
SEED_ADMIN_NAME=System Admin

# ===========================================
# Session Configuration
# ===========================================
SESSION_EXPIRY_HOURS=24

# ===========================================
# CORS Configuration
# ===========================================
FRONTEND_URL=http://localhost:5174
ALLOWED_ORIGINS=http://localhost:5174,http://localhost:3000

# ===========================================
# LLM Configuration
# ===========================================
# Get your API key from: https://platform.openai.com/api-keys
OPENAI_API_KEY=sk-...
LLM_MODEL=gpt-5-nano

# ===========================================
# Internal Agent Services
# Leave USE_* flags false for local uvicorn (in-process fallback).
# docker compose sets these to true automatically.
# ===========================================
INTERNAL_SERVICE_TOKEN=local-dev-recovery-token
USE_RECOVERY_AGENT_SERVICE=false
RECOVERY_AGENT_URL=http://localhost:8001
USE_HEAD_COACH_SERVICE=false
HEAD_COACH_URL=http://localhost:8002
USE_SUMMARIZER_SERVICE=false
SUMMARIZER_URL=http://localhost:8003
USE_NUTRITION_AGENT_SERVICE=false
NUTRITION_AGENT_URL=http://localhost:8004

# USDA FoodData Central API key for nutrition food searches and details.
USDA_FDC_API_KEY=

# ===========================================
# AWS Configuration (Production Only)
# Leave blank for local development
# ===========================================
AWS_REGION=
AWS_ACCESS_KEY_ID=
AWS_SECRET_ACCESS_KEY=
S3_BUCKET=
S3_PREFIX=chat-history

# ===========================================
# Redis Configuration (Production Only)
# Leave blank for local development
# ===========================================
REDIS_URL=

# ===========================================
# Application Settings
# ===========================================
APP_NAME=Multi-Agent Coach API
APP_VERSION=1.0.0
DEBUG=false
